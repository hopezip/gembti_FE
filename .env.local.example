# 백엔드 API — auth(/api/v1/auth/*)는 실서버 직결(passthrough), 나머지는 MSW mock (LOGIN-FE-006)
#   ⚠️ 쿠키 인증(refresh)이 동작하려면 백엔드 CORS allow-origin에 이 오리진이 정확히 포함돼야 한다.
#      현재 실측 허용: http://localhost:3000. 배포 오리진은 백엔드 협의 필요(LOGIN-FE-006 R1).
NEXT_PUBLIC_API_BASE_URL=https://gembti.cloud

# MSW 토글 (true = mock; auth는 미등록이라 실서버 passthrough · steam/games/home은 mock)
NEXT_PUBLIC_USE_MOCK=true

# Steam OpenID 인증 시작 URL (REQ-003 가설정 · A안에선 미사용, 빈 값 유지)
NEXT_PUBLIC_STEAM_AUTH_START_URL=

# ── AI 게임 설명(AI-FE-001~003) · 서버 전용, 클라이언트 비노출(NEXT_PUBLIC_ 금지) ──
# Vercel AI Gateway. 모델명은 하드코딩하지 않고 env로 제어(spec §4).
AI_GATEWAY_API_KEY=
AI_PRIMARY_MODEL=google/gemini-2.5-flash-lite
AI_FALLBACK_MODELS=google/gemini-2.5-flash
