{
  "openapi": "3.1.0",
  "info": { "title": "GEMBTI_API", "version": "0.1.0" },
  "paths": {
    "/api/v1/auth/email/send-code": {
      "post": {
        "tags": ["Auth"],
        "summary": "Send Email Code Api",
        "operationId": "send_email_code_api_api_v1_auth_email_send_code_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EmailCodeSendRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/email/verify": {
      "post": {
        "tags": ["Auth"],
        "summary": "Verify Email Api",
        "operationId": "verify_email_api_api_v1_auth_email_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailCodeVerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/signup": {
      "post": {
        "tags": ["Auth"],
        "summary": "Signup Api",
        "operationId": "signup_api_api_v1_auth_signup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SignupRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login Api",
        "operationId": "login_api_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Refresh Api",
        "operationId": "refresh_api_api_v1_auth_refresh_post",
        "parameters": [
          {
            "name": "refresh_token",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [{ "type": "string" }, { "type": "null" }],
              "title": "Refresh Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AccessTokenResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Logout Api",
        "operationId": "logout_api_api_v1_auth_logout_post",
        "security": [{ "HTTPBearer": [] }],
        "parameters": [
          {
            "name": "refresh_token",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [{ "type": "string" }, { "type": "null" }],
              "title": "Refresh Token"
            }
          }
        ],
        "responses": {
          "204": { "description": "Successful Response" },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Me Api",
        "operationId": "me_api_api_v1_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponse" }
              }
            }
          }
        },
        "security": [{ "HTTPBearer": [] }]
      }
    }
  },
  "components": {
    "schemas": {
      "AccessTokenResponse": {
        "properties": {
          "access_token": { "type": "string", "title": "Access Token" },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          }
        },
        "type": "object",
        "required": ["access_token"],
        "title": "AccessTokenResponse"
      },
      "AuthResponse": {
        "properties": {
          "access_token": { "type": "string", "title": "Access Token" },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          },
          "user": { "$ref": "#/components/schemas/UserResponse" }
        },
        "type": "object",
        "required": ["access_token", "user"],
        "title": "AuthResponse"
      },
      "EmailCodeSendRequest": {
        "properties": {
          "email": { "type": "string", "format": "email", "title": "Email" },
          "purpose": {
            "$ref": "#/components/schemas/EmailVerificationPurpose",
            "default": "SIGNUP"
          }
        },
        "type": "object",
        "required": ["email"],
        "title": "EmailCodeSendRequest"
      },
      "EmailCodeVerifyRequest": {
        "properties": {
          "email": { "type": "string", "format": "email", "title": "Email" },
          "purpose": {
            "$ref": "#/components/schemas/EmailVerificationPurpose",
            "default": "SIGNUP"
          },
          "code": { "type": "string", "pattern": "^\\d{6}$", "title": "Code" }
        },
        "type": "object",
        "required": ["email", "code"],
        "title": "EmailCodeVerifyRequest"
      },
      "EmailVerificationPurpose": {
        "type": "string",
        "enum": ["SIGNUP", "PASSWORD_RESET"],
        "title": "EmailVerificationPurpose"
      },
      "Gender": {
        "type": "string",
        "enum": ["male", "female", "other"],
        "title": "Gender"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": { "$ref": "#/components/schemas/ValidationError" },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginProvider": {
        "type": "string",
        "enum": ["email", "steam"],
        "title": "LoginProvider"
      },
      "LoginRequest": {
        "properties": {
          "email": { "type": "string", "format": "email", "title": "Email" },
          "password": { "type": "string", "title": "Password" }
        },
        "type": "object",
        "required": ["email", "password"],
        "title": "LoginRequest"
      },
      "MessageResponse": {
        "properties": { "message": { "type": "string", "title": "Message" } },
        "type": "object",
        "required": ["message"],
        "title": "MessageResponse"
      },
      "SignupRequest": {
        "properties": {
          "email": { "type": "string", "format": "email", "title": "Email" },
          "password": {
            "type": "string",
            "maxLength": 100,
            "minLength": 10,
            "title": "Password"
          },
          "password_confirm": { "type": "string", "title": "Password Confirm" },
          "nickname": {
            "type": "string",
            "maxLength": 8,
            "minLength": 2,
            "title": "Nickname"
          },
          "gender": {
            "anyOf": [
              { "$ref": "#/components/schemas/Gender" },
              { "type": "null" }
            ]
          },
          "birth_date": {
            "anyOf": [
              { "type": "string", "format": "date" },
              { "type": "null" }
            ],
            "title": "Birth Date"
          },
          "terms_agreed": { "type": "boolean", "title": "Terms Agreed" },
          "privacy_agreed": { "type": "boolean", "title": "Privacy Agreed" }
        },
        "type": "object",
        "required": [
          "email",
          "password",
          "password_confirm",
          "nickname",
          "terms_agreed",
          "privacy_agreed"
        ],
        "title": "SignupRequest"
      },
      "UserResponse": {
        "properties": {
          "id": { "type": "integer", "title": "Id" },
          "email": { "type": "string", "title": "Email" },
          "nickname": { "type": "string", "title": "Nickname" },
          "bio": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Bio"
          },
          "login_provider": { "$ref": "#/components/schemas/LoginProvider" },
          "status": { "$ref": "#/components/schemas/UserStatus" },
          "steam_linked": { "type": "boolean", "title": "Steam Linked" },
          "steam_id_64": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Steam Id 64"
          },
          "steam_avatar_url": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Steam Avatar Url"
          },
          "steam_sync_status": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Steam Sync Status"
          },
          "last_synced_at": {
            "anyOf": [
              { "type": "string", "format": "date-time" },
              { "type": "null" }
            ],
            "title": "Last Synced At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "nickname",
          "bio",
          "login_provider",
          "status",
          "steam_linked",
          "steam_id_64",
          "steam_avatar_url",
          "steam_sync_status",
          "last_synced_at"
        ],
        "title": "UserResponse"
      },
      "UserStatus": {
        "type": "string",
        "enum": ["active", "inactive", "withdrawn", "deleted"],
        "title": "UserStatus"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": { "anyOf": [{ "type": "string" }, { "type": "integer" }] },
            "type": "array",
            "title": "Location"
          },
          "msg": { "type": "string", "title": "Message" },
          "type": { "type": "string", "title": "Error Type" },
          "input": { "title": "Input" },
          "ctx": { "type": "object", "title": "Context" }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      }
    },
    "securitySchemes": { "HTTPBearer": { "type": "http", "scheme": "bearer" } }
  }
}
