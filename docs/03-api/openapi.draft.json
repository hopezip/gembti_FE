        "security": [{ "HTTPBearer": [] }],
        "responses": {
          "200": {
            "description": "1순위 추천 + 성향태그 + 추천 그리드 + 신규",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonalizedHomeEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/surveys/questions": {
      "x-status": "frontend-draft",
      "get": {
        "tags": ["Survey"],
        "summary": "설문 문항 조회 (SURVEY-FE-002)",
        "operationId": "get_survey_questions_api_v1_surveys_questions_get",
