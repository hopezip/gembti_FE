          "200": {
            "description": "설문 문항 목록",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/SurveyQuestion" }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/surveys/submit": {
      "x-status": "frontend-draft",
      "post": {
        "tags": ["Survey"],
        "summary": "설문 응답 제출 (SURVEY-FE-002)",
        "operationId": "submit_survey_api_v1_surveys_submit_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SurveySubmitRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "제출 결과",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SurveySubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "유효하지 않은 설문 응답",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorMessage" }
              }
            }
          }
        }
      }
    },
    "/api/v1/surveys/result": {
      "x-status": "frontend-draft",
      "get": {
        "tags": ["Survey"],
        "summary": "최신 설문 결과 조회 (SURVEY-FE-003)",
        "operationId": "get_survey_result_api_v1_surveys_result_get",
        "responses": {
          "200": {
            "description": "최신 설문 결과",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SurveyLatestResult" }
              }
            }
          }
        }
      }
    },
    "/api/v1/recommendations/generate": {
      "x-status": "frontend-draft",
      "post": {
        "tags": ["Recommendations"],
        "summary": "설문 기반 추천 생성 (SURVEY-FE-003)",
        "operationId": "generate_recommendations_api_v1_recommendations_generate_post",
        "responses": {
          "201": {
            "description": "추천 게임 목록",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SurveyRecommendations"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/mypage/profile": {
