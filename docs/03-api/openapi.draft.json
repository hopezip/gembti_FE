        "summary": "스팀 연동 해제 (MYPAGE-FE-002)",
        "operationId": "post_mypage_steam_disconnect_api_v1_mypage_steam_disconnect_post",
        "security": [{ "HTTPBearer": [] }],
        "responses": {
          "200": {
            "description": "해제 후 프로필",
