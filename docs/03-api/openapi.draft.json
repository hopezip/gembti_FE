              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PriceInfo": {
        "type": "object",
        "required": ["original_price", "sale_price", "discount_rate"],
        "properties": {
          "original_price": { "type": "integer" },
          "sale_price": { "type": ["integer", "null"] },
          "discount_rate": { "type": "integer" }
        }
      },
      "GameSearchItem": {
        "type": "object",
        "required": [
          "game_id",
          "title",
          "thumbnail_url",
          "genres",
          "tags",
          "rating",
          "price_info"
        ],
        "properties": {
          "game_id": { "type": "integer" },
          "title": { "type": "string" },
          "thumbnail_url": { "type": "string" },
          "genres": { "type": "array", "items": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string" } },
          "rating": { "type": ["number", "null"] },
          "price_info": { "$ref": "#/components/schemas/PriceInfo" }
        }
      },
      "GameSearchEnvelope": {
        "type": "object",
        "required": ["status", "data"],
        "properties": {
          "status": { "type": "string" },
          "data": {
            "type": "object",
            "required": ["games", "total_count", "has_more"],
            "properties": {
              "games": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/GameSearchItem" }
              },
              "total_count": { "type": "integer" },
              "has_more": { "type": "boolean" }
            }
          }
        }
      },
      "PriceRange": {
        "type": "object",
        "required": ["label", "min", "max"],
        "properties": {
          "label": { "type": "string" },
          "min": { "type": "integer" },
          "max": { "type": "integer" }
        }
      },
      "PlayModeOption": {
        "type": "object",
        "required": ["value", "label"],
        "properties": {
          "value": { "type": "string" },
          "label": { "type": "string" }
        }
      },
      "GameFilterOptionsEnvelope": {
        "type": "object",
        "required": ["status", "data"],
        "properties": {
          "status": { "type": "string" },
          "data": {
            "type": "object",
            "required": ["genres", "tags", "price_ranges", "play_modes"],
            "properties": {
              "genres": { "type": "array", "items": { "type": "string" } },
              "tags": { "type": "array", "items": { "type": "string" } },
              "price_ranges": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/PriceRange" }
              },
              "play_modes": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/PlayModeOption" }
              }
            }
          }
        }
      },
      "GameSummary": {
        "type": "object",
        "required": ["game_id", "title", "thumbnail_url", "genres", "rating"],
        "properties": {
          "game_id": { "type": "integer" },
          "title": { "type": "string" },
          "thumbnail_url": { "type": "string" },
          "genres": { "type": "array", "items": { "type": "string" } },
          "rating": { "type": ["number", "null"] }
        }
      },
      "SystemRequirement": {
        "type": "object",
        "required": ["os", "processor", "memory", "graphics", "storage"],
        "properties": {
          "os": { "type": "string" },
          "processor": { "type": "string" },
          "memory": { "type": "string" },
          "graphics": { "type": "string" },
          "storage": { "type": "string" }
        }
      },
      "AiMatch": {
        "type": "object",
        "required": ["match_rate", "reason_summary"],
        "properties": {
          "match_rate": { "type": "integer" },
          "score": { "type": "integer" },
          "reason_summary": { "type": "string" },
          "reason": { "type": "string" },
          "match_tags": { "type": "array", "items": { "type": "string" } }
        }
      },
      "ReviewStats": {
        "type": "object",
        "required": ["total_count", "positive_rate"],
        "properties": {
          "average": { "type": "number" },
          "total_count": { "type": "integer" },
          "positive_rate": { "type": "integer" },
          "distribution": {
            "type": "object",
            "additionalProperties": { "type": "integer" }
          }
        }
      },
      "GameDetail": {
        "type": "object",
        "required": ["game_id", "title", "genres", "tags", "price_info"],
        "properties": {
          "game_id": { "type": "integer" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "full_description": { "type": "string" },
          "genres": { "type": "array", "items": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string" } },
          "rating": { "type": ["number", "null"] },
          "review_count": { "type": "integer" },
          "price_info": { "$ref": "#/components/schemas/PriceInfo" },
          "developer": { "type": "string" },
          "publisher": { "type": "string" },
          "release_date": { "type": "string" },
          "thumbnail_url": { "type": "string" },
          "theme_image_url": { "type": "string" },
          "banner_url": { "type": "string" },
          "screenshot_urls": { "type": "array", "items": { "type": "string" } },
          "trailer_url": { "type": "string" },
          "system_requirements": {
            "type": "object",
            "properties": {
              "minimum": { "$ref": "#/components/schemas/SystemRequirement" },
              "recommended": {
                "$ref": "#/components/schemas/SystemRequirement"
              }
            }
          },
          "audio_languages": { "type": "array", "items": { "type": "string" } },
          "interface_languages": {
            "type": "array",
            "items": { "type": "string" }
          },
          "play_modes": { "type": "array", "items": { "type": "string" } },
          "korean_sub": { "type": "boolean" },
          "age_rating": { "type": "string" },
          "on_sale": { "type": "boolean" },
          "similar_games": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GameSummary" }
          },
          "developer_games": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GameSummary" }
          },
          "ai_match": { "$ref": "#/components/schemas/AiMatch" },
          "review_stats": { "$ref": "#/components/schemas/ReviewStats" }
        }
      },
      "GameDetailEnvelope": {
        "type": "object",
        "required": ["status", "data"],
        "properties": {
          "status": { "type": "string" },
          "data": { "$ref": "#/components/schemas/GameDetail" }
        }
      },
      "NotFoundEnvelope": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string" }
        }
      },
      "CurationBanner": {
        "type": "object",
        "required": [
          "main_copy",
          "sub_copy",
          "button_text",
          "background_image_url"
        ],
        "properties": {
          "main_copy": { "type": "string" },
          "sub_copy": { "type": "string" },
          "button_text": { "type": "string" },
          "background_image_url": { "type": "string" }
        }
      },
      "HomeGame": {
        "type": "object",
        "required": ["game_id", "title", "thumbnail_url", "genres", "rating"],
        "properties": {
          "game_id": { "type": "integer" },
          "title": { "type": "string" },
          "thumbnail_url": { "type": "string" },
          "genres": { "type": "array", "items": { "type": "string" } },
          "rating": { "type": ["number", "null"] },
          "is_new": { "type": "boolean" }
        }
      },
      "GuestHomeEnvelope": {
        "type": "object",
        "required": ["status", "data"],
        "properties": {
          "status": { "type": "string" },
          "data": {
            "type": "object",
            "required": ["curation_banner", "new_releases", "trending_games"],
            "properties": {
              "curation_banner": {
                "$ref": "#/components/schemas/CurationBanner"
              },
              "new_releases": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/HomeGame" }
              },
              "trending_games": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/HomeGame" }
              }
            }
          }
        }
      },
      "TopRecommendation": {
        "type": "object",
        "required": [
          "game_id",
          "title",
          "match_rate",
          "reason_summary",
          "background_url"
        ],
        "properties": {
          "game_id": { "type": "integer" },
          "title": { "type": "string" },
          "match_rate": { "type": "integer" },
          "reason_summary": { "type": "string" },
          "background_url": { "type": "string" }
        }
      },
      "PersonalizedGame": {
        "type": "object",
        "required": [
          "game_id",
          "title",
          "thumbnail_url",
          "genres",
          "rating",
          "match_rate",
          "reason_tagline"
        ],
        "properties": {
          "game_id": { "type": "integer" },
          "title": { "type": "string" },
          "thumbnail_url": { "type": "string" },
          "genres": { "type": "array", "items": { "type": "string" } },
          "rating": { "type": ["number", "null"] },
          "match_rate": { "type": "integer" },
          "reason_tagline": { "type": "string" }
        }
      },
      "RecommendationProfile": {
        "type": "object",
        "required": [
          "challenge_tags",
          "liked_meta",
          "challenge_meta",
          "last_updated_text"
        ],
        "properties": {
          "challenge_tags": { "type": "array", "items": { "type": "string" } },
          "liked_meta": { "type": "string" },
          "challenge_meta": { "type": "string" },
          "last_updated_text": { "type": "string" }
        }
      },
      "PersonalizedHomeEnvelope": {
        "type": "object",
        "required": ["status", "data"],
        "properties": {
          "status": { "type": "string" },
          "data": {
            "type": "object",
            "required": [
              "top_recommendation",
              "user_interest_tags",
              "recommended_games",
              "new_releases"
            ],
            "properties": {
              "top_recommendation": {
                "$ref": "#/components/schemas/TopRecommendation"
              },
              "user_interest_tags": {
                "type": "array",
                "items": { "type": "string" }
              },
              "recommended_games": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/PersonalizedGame" }
              },
              "new_releases": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/HomeGame" }
              },
              "recommendation_profile": {
                "$ref": "#/components/schemas/RecommendationProfile"
              }
            }
          }
        }
      },
      "SurveyQuestionOption": {
        "type": "object",
        "required": ["value", "label"],
        "properties": {
          "value": { "type": "integer" },
          "label": { "type": "string" }
        }
      },
      "SurveyQuestion": {
        "type": "object",
        "required": ["question_id", "text"],
        "properties": {
          "question_id": { "type": "integer" },
          "text": { "type": "string" },
          "options": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SurveyQuestionOption" }
          }
        }
      },
      "SurveyAnswer": {
        "type": "object",
        "required": ["question_id", "answer"],
        "properties": {
          "question_id": { "type": "integer" },
          "answer": { "type": "integer" }
        }
      },
      "SurveySubmitRequest": {
        "type": "object",
        "required": ["answers"],
        "properties": {
          "answers": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SurveyAnswer" }
          }
        }
      },
      "SurveyTendencyStat": {
        "type": "object",
        "required": ["label", "score"],
        "properties": {
          "label": { "type": "string" },
          "score": { "type": "number" }
        }
      },
      "SurveySubmitResponse": {
        "type": "object",
        "required": ["survey_id", "stats"],
        "properties": {
          "survey_id": { "type": "integer" },
          "type": { "type": "string" },
          "stats": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SurveyTendencyStat" }
          },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "SurveyLatestResult": {
        "type": "object",
        "required": ["survey_id", "stats"],
        "properties": {
          "survey_id": { "type": "integer" },
          "type": { "type": "string" },
          "stats": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SurveyTendencyStat" }
          },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "SurveyRecommendations": {
        "type": "object",
        "required": ["games"],
        "properties": {
          "games": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GameSummary" }
          }
        }
      },
      "ErrorMessage": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" }
        }
      },
      "MyPageStats": {
        "type": "object",
        "required": ["following", "followers", "totalPlayHours", "reviewCount"],
        "properties": {
          "following": { "type": "integer" },
          "followers": { "type": "integer" },
          "totalPlayHours": { "type": "integer" },
          "reviewCount": { "type": "integer" }
        }
      },
      "MyPagePersonality": {
        "type": "object",
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "integer" }
        }
      },
      "MyPageProfile": {
        "type": "object",
        "required": ["id", "nickname", "handle", "email"],
        "properties": {
          "id": { "type": "string" },
          "nickname": { "type": "string" },
          "handle": { "type": "string" },
          "avatarUrl": { "type": ["string", "null"] },
          "joinedAt": { "type": "string" },
          "isPublic": { "type": "boolean" },
          "steamConnected": { "type": "boolean" },
          "steamId": { "type": ["string", "null"] },
          "steamNickname": { "type": ["string", "null"] },
          "steamSyncedAt": { "type": ["string", "null"] },
          "email": { "type": "string" },
          "birthdate": { "type": "string" },
          "gender": {
            "type": ["string", "null"],
            "enum": ["남성", "여성", "기타", null]
          },
          "bio": { "type": "string" },
          "website": { "type": ["string", "null"] },
          "favoriteGenres": { "type": "array", "items": { "type": "string" } },
          "stats": { "$ref": "#/components/schemas/MyPageStats" },
          "personality": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/MyPagePersonality" }
          }
        }
      },
      "MyPageProfilePatch": {
        "type": "object",
        "description": "프로필 부분 수정 — MyPageProfile의 부분집합.",
        "properties": {
          "nickname": { "type": "string" },
          "handle": { "type": "string" },
          "avatarUrl": { "type": ["string", "null"] },
          "isPublic": { "type": "boolean" },
          "bio": { "type": "string" },
          "website": { "type": ["string", "null"] },
          "birthdate": { "type": "string" },
          "gender": {
            "type": ["string", "null"],
            "enum": ["남성", "여성", "기타", null]
          },
          "favoriteGenres": { "type": "array", "items": { "type": "string" } }
        }
      },
      "LibraryItem": {
        "type": "object",
        "required": [
          "id",
          "title",
          "genres",
          "playHours",
          "myRating",
          "status",
          "lastPlayedAt"
        ],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "genres": { "type": "array", "items": { "type": "string" } },
          "playHours": { "type": "number" },
          "myRating": { "type": ["number", "null"] },
          "status": {
            "type": "string",
            "enum": ["unplayed", "playing", "cleared", "dropped"]
          },
          "lastPlayedAt": { "type": ["string", "null"] }
        }
      },
      "LibraryPage": {
        "type": "object",
        "required": ["total", "items", "hasMore", "allGenres"],
        "properties": {
          "total": { "type": "integer" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/LibraryItem" }
          },
          "hasMore": { "type": "boolean" },
          "allGenres": { "type": "array", "items": { "type": "string" } }
        }
      },
      "OkResponse": {
        "type": "object",
        "required": ["ok"],
        "properties": {
          "ok": { "type": "boolean" }
        }
      },
      "AvailabilityResponse": {
        "type": "object",
        "required": ["available"],
        "properties": {
          "available": { "type": "boolean" }
        }
      }
    }
  }
}
