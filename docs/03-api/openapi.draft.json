{
  "openapi": "3.1.0",
  "info": {
    "title": "GamBTI API (frontend draft)",
    "version": "0.0.0-draft",
    "description": "프론트가 임시로 작성한 미확정 도메인 계약(games/home/survey/recommendations/mypage/users). 백엔드 Swagger가 확정되면 해당 도메인을 openapi.json으로 옮기고 여기서 삭제한다. 모든 path는 x-status: frontend-draft + api/v1/ 프리픽스로 통일. 코드 호출/MSW 핸들러에서 역추출(TASK-DEVEX-018)."
  },
  "paths": {
    "/api/v1/games/search": {
      "x-status": "frontend-draft",
      "get": {
        "tags": ["Games"],
        "summary": "게임 검색 (SEARCH-FE-001)",
        "operationId": "search_games_api_v1_games_search_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 1, "minimum": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 12, "minimum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "검색 결과",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GameSearchEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/v1/games/filter-options": {
      "x-status": "frontend-draft",
      "get": {
        "tags": ["Games"],
        "summary": "검색 필터 옵션 (SEARCH-FE-003)",
        "operationId": "get_game_filter_options_api_v1_games_filter_options_get",
        "responses": {
          "200": {
            "description": "필터 옵션",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameFilterOptionsEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/games/{gameId}": {
      "x-status": "frontend-draft",
      "get": {
        "tags": ["Games"],
        "summary": "게임 상세 (REC-DET-FE-001)",
        "operationId": "get_game_detail_api_v1_games_gameId_get",
        "parameters": [
          {
            "name": "gameId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "게임 상세",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GameDetailEnvelope" }
              }
            }
          },
          "404": {
            "description": "게임 없음",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NotFoundEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/v1/home/guest": {
      "x-status": "frontend-draft",
      "get": {
        "tags": ["Home"],
        "summary": "비로그인 홈 (MAIN-FE-003)",
        "operationId": "get_guest_home_api_v1_home_guest_get",
