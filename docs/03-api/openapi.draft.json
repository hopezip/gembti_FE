              "application/json": {
                "schema": { "$ref": "#/components/schemas/MyPageProfile" }
              }
            }
          }
        }
      }
    },
    "/api/v1/mypage/library": {
      "x-status": "frontend-draft",
      "get": {
        "tags": ["MyPage"],
        "summary": "라이브러리 조회 (MYPAGE-FE-006)",
        "operationId": "get_mypage_library_api_v1_mypage_library_get",
        "security": [{ "HTTPBearer": [] }],
        "parameters": [
          {
            "name": "genre",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "default": "recent" }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 1, "minimum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "라이브러리 페이지",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LibraryPage" }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/check-nickname": {
      "x-status": "frontend-draft",
      "get": {
        "tags": ["Users"],
        "summary": "닉네임 중복 확인 (EmailVerificationForm)",
        "operationId": "check_nickname_api_v1_users_check_nickname_get",
        "parameters": [
          {
            "name": "nickname",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "사용 가능 여부",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/check-email": {
      "x-status": "frontend-draft",
      "get": {
        "tags": ["Users"],
        "summary": "이메일 중복 확인 (SignupForm, LOGIN-FE-012)",
        "operationId": "check_email_api_v1_users_check_email_get",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "email" }
          }
        ],
        "responses": {
          "200": {
            "description": "사용 가능 여부",
